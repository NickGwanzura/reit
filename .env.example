# Required at runtime. Keep secrets in Dokploy or your local untracked .env file.
DATABASE_URL="postgresql://mutirikwi_app:REPLACE_ME@mutirikwi-reit-leads-db-5rk2md:5432/mutirikwi_reit?schema=public"
AUTH_SECRET="generate-a-unique-secret-with-npx-auth-secret"
AUTH_URL="https://mutirikwireitzim.com"
# Optional separate signing key for brochure access; defaults to AUTH_SECRET.
BROCHURE_ACCESS_SECRET=""

# Seed the first staff user once with `npm run db:seed-admin`; do not use a shared password.
CRM_ADMIN_EMAIL="fund-team@example.com"
CRM_ADMIN_PASSWORD="replace-with-a-long-unique-password"

# Optional transactional email. Leads are still stored if Resend is not configured.
RESEND_API_KEY=""
# Use a sender address from a domain verified in Resend.
EMAIL_FROM="Mutirikwi REIT <noreply@mutirikwireitzim.com>"
LEAD_NOTIFICATION_EMAILS="no-reply@redwood.co.zw,wisdom@redwood.co.zw,makanatsa@redwood.co.zw"
# Legacy single-recipient setting remains supported by the mailer.
LEAD_NOTIFICATION_EMAIL=""
