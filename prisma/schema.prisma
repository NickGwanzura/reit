generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  FUND_MANAGER
  RELATIONSHIP_MANAGER
  COMPLIANCE
  CONTENT_MANAGER
  INVESTOR
}

enum InvestorType {
  INDIVIDUAL
  DIASPORA
  CORPORATE
  PENSION_FUND
  INSURANCE
  BANK
  EMPLOYER
  OTHER
}

enum InvestmentRange {
  RANGE_100_999
  RANGE_1000_4999
  RANGE_5000_9999
  RANGE_10000_49999
  RANGE_50000_99999
  RANGE_100000_PLUS
}

enum InvestmentTimeline {
  IMMEDIATELY
  WITHIN_30_DAYS
  ONE_TO_THREE_MONTHS
  THREE_TO_SIX_MONTHS
  RESEARCHING
}

enum PreferredContact {
  PHONE
  WHATSAPP
  EMAIL
}

enum LeadStatus {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  INTERESTED
  KYC_STARTED
  KYC_SUBMITTED
  KYC_UNDER_REVIEW
  KYC_APPROVED
  SUBSCRIPTION_STARTED
  SUBSCRIPTION_SUBMITTED
  COMPLIANCE_REVIEW
  APPROVED
  ONBOARDED_INVESTOR
  DEFERRED
  LOST
}

enum ActivityType {
  LEAD_CREATED
  ENQUIRY_RECEIVED
  STAGE_CHANGED
  ASSIGNMENT_CHANGED
  NOTE_ADDED
  TASK_CREATED
  TASK_COMPLETED
  PHONE_CALL
  WHATSAPP_MESSAGE
  EMAIL
  MEETING
  EMAIL_SENT
}

enum TaskType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  FOLLOW_UP
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum TaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  passwordHash    String
  role            UserRole @default(RELATIONSHIP_MANAGER)
  isActive        Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  sessionVersion  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignedLeads   Lead[]   @relation("AssignedLeads")
  assignedTasks   Task[]   @relation("AssignedTasks")
  createdTasks    Task[]   @relation("CreatedTasks")
  activities      Activity[] @relation("ActivityActor")
  auditLogs       AuditLog[] @relation("AuditActor")
}

model Contact {
  id                  String       @id @default(cuid())
  firstName           String
  lastName            String
  email               String
  normalizedEmail     String       @unique
  phone               String?
  normalizedPhone     String?      @unique
  whatsapp            String?
  normalizedWhatsapp  String?      @unique
  country             String?
  investorType        InvestorType
  organisation        String?
  jobTitle            String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  lead                Lead?
}

model Lead {
  id                       String             @id @default(cuid())
  contactId                String             @unique
  status                   LeadStatus         @default(NEW_LEAD)
  intendedInvestmentRange InvestmentRange?
  timeline                 InvestmentTimeline?
  preferredContact         PreferredContact?
  assignedUserId           String?
  source                   String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  lastSubmissionAt         DateTime            @default(now())
  lastContactAt            DateTime?

  contact                  Contact            @relation(fields: [contactId], references: [id], onDelete: Restrict)
  assignedUser             User?              @relation("AssignedLeads", fields: [assignedUserId], references: [id], onDelete: SetNull)
  enquiries                Enquiry[]
  activities               Activity[]
  tasks                    Task[]

  @@index([status, updatedAt])
  @@index([assignedUserId, status])
}

model Enquiry {
  id                 String             @id @default(cuid())
  leadId             String
  firstName          String
  lastName           String
  email              String
  phone              String?
  whatsapp           String?
  country            String?
  investorType       InvestorType
  investmentRange    InvestmentRange
  timeline           InvestmentTimeline
  preferredContact   PreferredContact
  consentAt          DateTime
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  referrer           String?
  landingPage        String?
  createdAt          DateTime           @default(now())

  lead               Lead               @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([utmCampaign, createdAt])
}

model Activity {
  id             String       @id @default(cuid())
  leadId         String
  actorUserId    String?
  type           ActivityType
  body           String?
  metadata        Json?
  createdAt      DateTime     @default(now())

  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Restrict)
  actor          User?        @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model Task {
  id             String       @id @default(cuid())
  leadId         String
  createdById    String
  assignedToId   String?
  title          String
  description    String?
  type           TaskType     @default(FOLLOW_UP)
  priority       TaskPriority @default(NORMAL)
  status         TaskStatus   @default(OPEN)
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Restrict)
  createdBy      User         @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo     User?        @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([assignedToId, status, dueAt])
  @@index([leadId, createdAt])
}

model AuditLog {
  id             String    @id @default(cuid())
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  oldValue       Json?
  newValue       Json?
  ipHash         String?
  createdAt      DateTime  @default(now())

  actor          User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

model LoginThrottle {
  key         String   @id
  attempts    Int      @default(0)
  windowStart DateTime
  blockedUntil DateTime?
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}
